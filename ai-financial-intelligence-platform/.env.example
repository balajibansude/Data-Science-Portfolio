# PostgreSQL
POSTGRES_DB=financial_intelligence
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# API
APP_ENV=development
APP_NAME=AI Financial Intelligence Platform API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://platform_user:change-me-for-local-development@localhost:5432/financial_intelligence
BACKEND_CORS_ORIGINS=http://localhost:5173
API_PORT=8000
UPLOAD_DIR=data/uploads
REPORTS_DIR=data/reports
MODELS_DIR=data/models
UPLOAD_MAX_SIZE_BYTES=10485760

# Frontend
FRONTEND_PORT=5173
